{HPML 宽基 ETF_CSI_1000 - hp-ml 通达信公式导出}
{生成时间：2026-06-05T08:50:07}
{模型：lite_stdlib_ridge; 目标：预测未来5日收益; 源模型时间：2026-06-03T20:07:49}
{说明：仅线性/Ridge 模型可精确展开; 输出仅作量化研究，不构成投资建议。}
{指数族：CSI_1000; 可用：CSI_1000, CSI_2000, CSI_300, CSI_500, CSI_800, CSI_A50, CSI_A500}
{近似：TURN 使用 VOL/CAPITAL*100; DAYS 使用 BARSCOUNT(CLOSE)-1 近似原始自然日特征。}

R1:=CLOSE/REF(CLOSE,1)-1; {1 日收益}
R3:=CLOSE/REF(CLOSE,3)-1; {3 日收益}
R5:=CLOSE/REF(CLOSE,5)-1; {5 日收益}
R10:=CLOSE/REF(CLOSE,10)-1; {10 日收益}
R20:=CLOSE/REF(CLOSE,20)-1; {20 日收益}
R60:=CLOSE/REF(CLOSE,60)-1; {60 日收益}
SD5:=STD(CLOSE/REF(CLOSE,1)-1,5); {5 日收益波动率}
SD20:=STD(CLOSE/REF(CLOSE,1)-1,20); {20 日收益波动率}
SD60:=STD(CLOSE/REF(CLOSE,1)-1,60); {60 日收益波动率}
MA520:=MA(CLOSE,5)/MA(CLOSE,20)-1; {5/20 日均线乖离}
MA2060:=MA(CLOSE,20)/MA(CLOSE,60)-1; {20/60 日均线乖离}
DD20:=CLOSE/HHV(CLOSE,20)-1; {20 日回撤}
DD60:=CLOSE/HHV(CLOSE,60)-1; {60 日回撤}
AMTLOG:=LN(MAX(AMOUNT,0)+1); {成交额 log1p}
AMTZ20:=(AMOUNT-MA(AMOUNT,20))/MAX(STD(AMOUNT,20),0.000001); {20 日成交额 z 分数}
TURN:=VOL/MAX(CAPITAL,1)*100; {换手率近似}
AMPL:=(HIGH-LOW)/MAX(REF(CLOSE,1),0.000001)*100; {振幅百分比}
IRANGE:=(HIGH-LOW)/MAX(CLOSE,0.000001); {日内振幅}
VCHG5:=VOL/REF(VOL,5)-1; {5 日成交量变化}
LS20:=AMOUNT/MAX(MA(AMOUNT,20),0.000001)-1; {20 日成交额冲击}
MSIN:=SIN(2*3.1415926*MONTH/12); {月份 sin 周期}
MCOS:=COS(2*3.1415926*MONTH/12); {月份 cos 周期}
DAYS:=BARSCOUNT(CLOSE)-1; {上市以来交易日数近似}
FAM1:=1; {family_CSI_1000 常量, family_id=CSI_1000}
FAM2:=0; {family_CSI_2000 常量, family_id=CSI_1000}
FAM3:=0; {family_CSI_300 常量, family_id=CSI_1000}
FAM4:=0; {family_CSI_500 常量, family_id=CSI_1000}
FAM5:=0; {family_CSI_800 常量, family_id=CSI_1000}
FAM6:=0; {family_CSI_A50 常量, family_id=CSI_1000}
FAM7:=0; {family_CSI_A500 常量, family_id=CSI_1000}

S0:=0.0014538693; {截距}
S1:=S0+(0.0018366833)*((R1)-(0.0002746119))/(0.0180587952); {ret_1}
S2:=S1+(-0.0021097577)*((R3)-(0.0007887661))/(0.0314479604); {ret_3}
S3:=S2+(0.0023576796)*((R5)-(0.0012940484))/(0.0399430261); {ret_5}
S4:=S3+(0.0004373337)*((R10)-(0.0025816069))/(0.0565287239); {ret_10}
S5:=S4+(0.0089563559)*((R20)-(0.0054286896))/(0.0807877734); {ret_20}
S6:=S5+(-0.0013678275)*((R60)-(0.0160476442))/(0.146633647); {ret_60}
S7:=S6+(-0.001777292)*((SD5)-(0.0139070557))/(0.011593975); {vol_5}
S8:=S7+(-0.0003107055)*((SD20)-(0.0151159409))/(0.0098932021); {vol_20}
S9:=S8+(-0.0043959134)*((SD60)-(0.0157739198))/(0.0087520892); {vol_60}
S10:=S9+(0.000878883)*((MA520)-(0.0009732335))/(0.0347885464); {ma_gap_5_20}
S11:=S10+(-0.0017356787)*((MA2060)-(0.0024870818))/(0.0528642146); {ma_gap_20_60}
S12:=S11+(-0.0115316979)*((DD20)-(-0.0384238535))/(0.0487186559); {drawdown_20}
S13:=S12+(-0.00146446)*((DD60)-(-0.0716496358))/(0.0743848643); {drawdown_60}
S14:=S13+(0)*((AMTLOG)-(0))/(1); {amount_log}
S15:=S14+(0)*((AMTZ20)-(0))/(1); {amount_z20}
S16:=S15+(0)*((TURN)-(0))/(1); {turnover_rate}
S17:=S16+(-0.0053950011)*((AMPL)-(2.0017189285))/(1.6287694598); {amplitude}
S18:=S17+(0.004656166)*((IRANGE)-(0.0200340986))/(0.0163833022); {intraday_range}
S19:=S18+(-0.000098604037)*((VCHG5)-(0.8033217453))/(22.928371185); {volume_chg_5}
S20:=S19+(0)*((LS20)-(0))/(1); {liquidity_shock_20}
S21:=S20+(0.001951991)*((MSIN)-(-0.0657043507))/(0.6960612846); {month_sin}
S22:=S21+(-0.0002453585)*((MCOS)-(0.0160966414))/(0.714819373); {month_cos}
S23:=S22+(-0.0020122143)*((DAYS)-(1591.8606324392))/(1175.192565236); {days_since_start}
S24:=S23+(-0.0014328696)*((FAM1)-(0.127731391))/(0.3337978899); {family_CSI_1000}
S25:=S24+(-0.0011861353)*((FAM2)-(0.0249600284))/(0.1560067509); {family_CSI_2000}
S26:=S25+(0.0012619483)*((FAM3)-(0.360365962))/(0.4801172494); {family_CSI_300}
S27:=S26+(0.0003693049)*((FAM4)-(0.402513768))/(0.4904152487); {family_CSI_500}
S28:=S27+(-0.0004344423)*((FAM5)-(0.0807869959))/(0.2725137712); {family_CSI_800}
S29:=S28+(-0.000087491876)*((FAM6)-(0.0036418547))/(0.0602391296); {family_CSI_A50}
S30:=S29+(0)*((FAM7)-(0))/(1); {family_CSI_A500}

HPMLSCORE:S30,COLORWHITE;
HPMLBUY:IF(S30>0,1,0),COLORRED;
