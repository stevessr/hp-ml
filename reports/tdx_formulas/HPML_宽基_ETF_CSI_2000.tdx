{警告：树模型无法精确转换为通达信公式}
{本公式使用 Ridge 回归拟合树模型输出作为近似}
{预估精度约 70-80%，仅供参考}
{警告：模型无 feature_importances 且无训练数据，使用均匀权重，精度可能很低}
{HPML 宽基 ETF_CSI_2000 [近似-均匀权重] - hp-ml 通达信公式导出}
{生成时间：2026-06-09T15:06:07}
{模型：HistGradientBoostingRegressor_approximate_均匀权重; 目标：预测未来5日收益; 源模型时间：2026-06-05T08:45:40}
{说明：仅线性/Ridge 模型可精确展开; 输出仅作量化研究，不构成投资建议。}
{指数族：CSI_2000; 可用：CSI_1000, CSI_2000, CSI_300, CSI_500, CSI_800, CSI_A100, CSI_A50, CSI_A500}
{近似：TURN 使用 VOL/CAPITAL*100; DAYS 使用 BARSCOUNT(CLOSE)-1 近似原始自然日特征。}

R1:=CLOSE/REF(CLOSE,1)-1; {1 日收益}
R3:=CLOSE/REF(CLOSE,3)-1; {3 日收益}
R5:=CLOSE/REF(CLOSE,5)-1; {5 日收益}
R10:=CLOSE/REF(CLOSE,10)-1; {10 日收益}
R20:=CLOSE/REF(CLOSE,20)-1; {20 日收益}
R60:=CLOSE/REF(CLOSE,60)-1; {60 日收益}
SD5:=STD(CLOSE/REF(CLOSE,1)-1,5); {5 日收益波动率}
SD20:=STD(CLOSE/REF(CLOSE,1)-1,20); {20 日收益波动率}
SD60:=STD(CLOSE/REF(CLOSE,1)-1,60); {60 日收益波动率}
MA520:=MA(CLOSE,5)/MA(CLOSE,20)-1; {5/20 日均线乖离}
MA2060:=MA(CLOSE,20)/MA(CLOSE,60)-1; {20/60 日均线乖离}
DD20:=CLOSE/HHV(CLOSE,20)-1; {20 日回撤}
DD60:=CLOSE/HHV(CLOSE,60)-1; {60 日回撤}
AMTLOG:=LN(MAX(AMOUNT,0)+1); {成交额 log1p}
AMTZ20:=(AMOUNT-MA(AMOUNT,20))/MAX(STD(AMOUNT,20),0.000001); {20 日成交额 z 分数}
TURN:=VOL/MAX(CAPITAL,1)*100; {换手率近似}
AMPL:=(HIGH-LOW)/MAX(REF(CLOSE,1),0.000001)*100; {振幅百分比}
IRANGE:=(HIGH-LOW)/MAX(CLOSE,0.000001); {日内振幅}
VCHG5:=VOL/REF(VOL,5)-1; {5 日成交量变化}
LS20:=AMOUNT/MAX(MA(AMOUNT,20),0.000001)-1; {20 日成交额冲击}
MSIN:=SIN(2*3.1415926*MONTH/12); {月份 sin 周期}
MCOS:=COS(2*3.1415926*MONTH/12); {月份 cos 周期}
DAYS:=BARSCOUNT(CLOSE)-1; {上市以来交易日数近似}
FAM1:=0; {family_CSI_1000 常量, family_id=CSI_2000}
FAM2:=1; {family_CSI_2000 常量, family_id=CSI_2000}
FAM3:=0; {family_CSI_300 常量, family_id=CSI_2000}
FAM4:=0; {family_CSI_500 常量, family_id=CSI_2000}
FAM5:=0; {family_CSI_800 常量, family_id=CSI_2000}
FAM6:=0; {family_CSI_A100 常量, family_id=CSI_2000}
FAM7:=0; {family_CSI_A50 常量, family_id=CSI_2000}
FAM8:=0; {family_CSI_A500 常量, family_id=CSI_2000}

S0:=0; {截距}
S1:=S0+(0.0322580645)*((R1)-(0))/(1); {ret_1}
S2:=S1+(0.0322580645)*((R3)-(0))/(1); {ret_3}
S3:=S2+(0.0322580645)*((R5)-(0))/(1); {ret_5}
S4:=S3+(0.0322580645)*((R10)-(0))/(1); {ret_10}
S5:=S4+(0.0322580645)*((R20)-(0))/(1); {ret_20}
S6:=S5+(0.0322580645)*((R60)-(0))/(1); {ret_60}
S7:=S6+(0.0322580645)*((SD5)-(0))/(1); {vol_5}
S8:=S7+(0.0322580645)*((SD20)-(0))/(1); {vol_20}
S9:=S8+(0.0322580645)*((SD60)-(0))/(1); {vol_60}
S10:=S9+(0.0322580645)*((MA520)-(0))/(1); {ma_gap_5_20}
S11:=S10+(0.0322580645)*((MA2060)-(0))/(1); {ma_gap_20_60}
S12:=S11+(0.0322580645)*((DD20)-(0))/(1); {drawdown_20}
S13:=S12+(0.0322580645)*((DD60)-(0))/(1); {drawdown_60}
S14:=S13+(0.0322580645)*((AMTLOG)-(0))/(1); {amount_log}
S15:=S14+(0.0322580645)*((AMTZ20)-(0))/(1); {amount_z20}
S16:=S15+(0.0322580645)*((TURN)-(0))/(1); {turnover_rate}
S17:=S16+(0.0322580645)*((AMPL)-(0))/(1); {amplitude}
S18:=S17+(0.0322580645)*((IRANGE)-(0))/(1); {intraday_range}
S19:=S18+(0.0322580645)*((VCHG5)-(0))/(1); {volume_chg_5}
S20:=S19+(0.0322580645)*((LS20)-(0))/(1); {liquidity_shock_20}
S21:=S20+(0.0322580645)*((MSIN)-(0))/(1); {month_sin}
S22:=S21+(0.0322580645)*((MCOS)-(0))/(1); {month_cos}
S23:=S22+(0.0322580645)*((DAYS)-(0))/(1); {days_since_start}
S24:=S23+(0.0322580645)*((FAM1)-(0))/(1); {family_CSI_1000}
S25:=S24+(0.0322580645)*((FAM2)-(0))/(1); {family_CSI_2000}
S26:=S25+(0.0322580645)*((FAM3)-(0))/(1); {family_CSI_300}
S27:=S26+(0.0322580645)*((FAM4)-(0))/(1); {family_CSI_500}
S28:=S27+(0.0322580645)*((FAM5)-(0))/(1); {family_CSI_800}
S29:=S28+(0.0322580645)*((FAM6)-(0))/(1); {family_CSI_A100}
S30:=S29+(0.0322580645)*((FAM7)-(0))/(1); {family_CSI_A50}
S31:=S30+(0.0322580645)*((FAM8)-(0))/(1); {family_CSI_A500}

HPMLSCORE:S31,COLORWHITE;
HPMLBUY:IF(S31>0,1,0),COLORRED;
